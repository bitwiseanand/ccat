---
import ExamLayout from './ExamLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RelatedContent from '../components/RelatedContent.astro';
import FAQ from '../components/FAQ.astro';
import type { ContentItem } from '../utils/content';

interface Props {
  title: string;
  description: string;
  exam: string;
  subject: string;
  date: Date;
  updatedDate?: Date;
  keywords?: string[];
  breadcrumbs: { label: string; href: string }[];
  headings: { depth: number; slug: string; text: string }[];
  relatedItems: ContentItem[];
  faq?: { question: string; answer: string }[];
  notesLink?: { href: string; label: string } | null;
}

const { title, description, exam, subject, date, updatedDate, keywords, breadcrumbs, headings, relatedItems, faq, notesLink } = Astro.props;
---

<ExamLayout
  title={title}
  description={description}
  exam={exam}
  subject={subject}
  type="article"
  date={date}
  updatedDate={updatedDate}
  keywords={keywords}
  breadcrumbs={breadcrumbs}
  faq={faq}
>
  <div class="cheatsheet-layout">
    <aside class="toc-sidebar">
      <TableOfContents headings={headings} />
    </aside>

    <article class="cheatsheet-content">
      <header class="cheatsheet-header">
        <h1>{title}</h1>
        <div class="meta">
          <span class="subject-badge">{subject}</span>
          <span class="date">Last verified: {date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          {updatedDate && (
            <span class="updated">Updated: {updatedDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          )}
        </div>
      </header>

      {notesLink && (
        <a href={notesLink.href} class="cross-link-callout">
          📖 Want more detail on specific topics? Browse all <strong>{notesLink.label}</strong> notes →
        </a>
      )}

      <div class="content-body">
        <slot />
      </div>

      {faq && <FAQ faq={faq} />}

      <RelatedContent items={relatedItems} />
    </article>
  </div>
</ExamLayout>

<style>
  .cheatsheet-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2.5rem;
  }
  @media (max-width: 900px) {
    .cheatsheet-layout { grid-template-columns: 1fr; }
  }
  .toc-sidebar {
    position: relative;
    margin-bottom: 1.5rem;
  }
  .cheatsheet-content {
    min-width: 0;
  }
  .cheatsheet-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .cheatsheet-header h1 {
    margin: 0 0 0.75rem 0;
    font-size: 2rem;
    line-height: 1.2;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .subject-badge {
    background: var(--exam-color);
    color: white;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .content-body {
    font-size: 1rem;
    line-height: 1.7;
  }
  .content-body :global(h2) {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .content-body :global(h3) {
    margin-top: 1.75rem;
  }
  .cross-link-callout {
    display: block;
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 10px;
    color: #1e3a8a;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .cross-link-callout:hover {
    border-color: #93c5fd;
    background: #dbeafe;
  }
  .cross-link-callout strong {
    color: #1e40af;
  }
</style>
