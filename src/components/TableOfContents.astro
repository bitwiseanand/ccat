---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Only show h2 and h3
const toc = headings.filter(h => h.depth >= 2 && h.depth <= 3);

if (toc.length < 3) return;
---

<nav class="toc toc-desktop" aria-label="Table of contents">
  <h2>On this page</h2>
  <ul>
    {toc.map(heading => (
      <li class={`depth-${heading.depth}`}>
        <a href={`#${heading.slug}`}>{heading.text}</a>
      </li>
    ))}
  </ul>
</nav>

<details class="toc toc-mobile-details">
  <summary>On this page</summary>
  <ul>
    {toc.map(heading => (
      <li class={`depth-${heading.depth}`}>
        <a href={`#${heading.slug}`}>{heading.text}</a>
      </li>
    ))}
  </ul>
</details>

<style>
  .toc-mobile-details {
    display: none;
  }
  @media (max-width: 900px) {
    .toc-desktop { display: none; }
    .toc-mobile-details { display: block; }
  }
  .toc-mobile-details summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748b;
    font-weight: 600;
  }
  .toc-mobile-details summary::-webkit-details-marker {
    display: none;
  }
  .toc-mobile-details summary::after {
    content: "▾";
    float: right;
    font-size: 1rem;
  }
  .toc-mobile-details[open] summary::after {
    content: "▴";
  }
  .toc-mobile-details ul {
    margin-top: 0.75rem;
  }
</style>

<style>
  .toc {
    position: sticky;
    top: 2rem;
    padding: 1rem;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    font-size: 0.875rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }
  @media (max-width: 900px) {
    .toc { position: static; max-height: none; }
  }
  .toc h2 {
    margin: 0 0 0.75rem 0;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748b;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .toc a {
    display: block;
    padding: 0.35rem 0.5rem;
    color: #475569;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
  }
  .toc a:hover {
    background: #e2e8f0;
    color: #0f172a;
  }
  .toc .depth-3 a {
    padding-left: 1.25rem;
    font-size: 0.8rem;
  }
</style>
