---
interface CourseItem {
  title: string;
  slug: string;
  readTime: string;
}

interface CourseGroup {
  subject: string;
  subjectLabel: string;
  items: CourseItem[];
}

interface Props {
  groups: CourseGroup[];
  currentSubject: string;
  currentSlug: string;
}

const { groups, currentSubject, currentSlug } = Astro.props;
---

<nav class="sidebar-nav" aria-label="Notes course outline">
  {groups.map((group) => (
    <div class={`subject-group ${group.subject === currentSubject ? 'current-group' : ''}`}>
      <a href={`/notes/${group.subject}/`} class="sidebar-title">{group.subjectLabel}</a>
      <ul>
        {group.items.map((item) => (
          <li>
            <a
              href={`/notes/${group.subject}/${item.slug}/`}
              class={group.subject === currentSubject && item.slug === currentSlug ? 'active' : ''}
              aria-current={group.subject === currentSubject && item.slug === currentSlug ? 'page' : undefined}
            >
              <span class="item-title">{item.title}</span>
              <span class="item-time">{item.readTime}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  .sidebar-nav {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    font-size: 0.9rem;
  }
  .subject-group + .subject-group {
    border-top: 1px solid var(--color-border);
  }
  .sidebar-title {
    display: block;
    padding: 0.75rem 1rem;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-surface);
  }
  .current-group .sidebar-title {
    color: var(--color-primary-dark);
  }
  .sidebar-title:hover {
    text-decoration: underline;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0.3rem;
  }
  li + li {
    margin-top: 1px;
  }
  a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-text-secondary);
    border-left: 2px solid transparent;
    line-height: 1.35;
    font-size: 0.85rem;
  }
  a:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }
  a.active {
    background: #eff6ff;
    border-left-color: var(--color-primary);
    color: var(--color-primary-dark);
    font-weight: 600;
  }
  .item-title {
    flex: 1;
  }
  .item-time {
    flex-shrink: 0;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  a.active .item-time {
    color: var(--color-primary-dark);
  }
</style>
