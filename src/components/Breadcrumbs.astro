---
interface Props {
  items: { label: string; href: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    <li>
      <a href="/">Home</a>
    </li>
    {items.map((item, index) => (
      <li>
        {index === items.length - 1 ? (
          <span aria-current="page">{item.label}</span>
        ) : (
          <a href={item.href}>{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding: 1rem 0;
    font-size: 0.875rem;
    color: #64748b;
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
  }
  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin: 0 0.5rem;
    color: #94a3b8;
  }
  .breadcrumbs a {
    color: #0ea5e9;
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .breadcrumbs span[aria-current] {
    color: #334155;
    font-weight: 500;
  }
</style>
