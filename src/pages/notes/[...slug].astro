---
import { getCollection } from 'astro:content';
import NotesLayout from '../../layouts/NotesLayout.astro';
import NotesSidebar from '../../components/NotesSidebar.astro';
import { getExamConfig } from '../../data/exams';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => {
    const id = note.id.replace(/\.mdx?$/, '');
    const slug = id.endsWith('/overview') ? id.replace(/\/overview$/, '') : id;
    const subject = id.split('/')[0];
    return {
      params: { slug },
      props: { entry: note, subject, isOverview: id.endsWith('/overview') },
    };
  });
}

const { entry, subject, isOverview } = Astro.props;

const allNotes = await getCollection('notes');

function readTimeFor(body: string): string {
  const words = body.trim().split(/\s+/).filter(Boolean).length;
  return `${Math.max(1, Math.round(words / 200))} min read`;
}

// Full, sorted list of real sections in this subject — used for both the
// overview page's grid AND the persistent sidebar on every note page.
const sections = allNotes
  .filter((n) => {
    const nid = n.id.replace(/\.mdx?$/, '');
    return nid.startsWith(`${subject}/`) && !nid.endsWith('/overview');
  })
  .map((n) => ({
    title: n.data.title,
    description: n.data.description,
    slug: n.id.replace(/\.mdx?$/, '').replace(`${subject}/`, ''),
    order: n.data.order || 999,
    readTime: readTimeFor(n.body || ''),
  }))
  .sort((a, b) => a.order - b.order);

const currentSlug = isOverview ? '' : entry.id.replace(/\.mdx?$/, '').replace(`${subject}/`, '');

// Sequential prev/next within the subject, batch-order aware via the same
// `order` field the sidebar and overview grid already sort by.
let prevNote: { title: string; slug: string } | null = null;
let nextNote: { title: string; slug: string } | null = null;
if (!isOverview) {
  const idx = sections.findIndex((s) => s.slug === currentSlug);
  if (idx > 0) prevNote = sections[idx - 1];
  if (idx >= 0 && idx < sections.length - 1) nextNote = sections[idx + 1];
}

// Resolve the optional cross-link to a fast-revision cheat sheet, if this
// note declares one (relatedCheatsheet stored as "exam/slug").
let relatedCheatsheet: { title: string; href: string } | null = null;
if (entry.data.relatedCheatsheet) {
  const sheets = await getCollection('cheatsheets');
  const match = sheets.find((s) => s.id.replace(/\.md$/, '') === entry.data.relatedCheatsheet);
  if (match) {
    const [sheetExam, ...rest] = match.id.replace(/\.md$/, '').split('/');
    relatedCheatsheet = {
      title: match.data.title,
      href: `/${sheetExam}/cheat-sheets/${rest.join('/')}/`,
    };
  }
}

const subjectLabel = subject.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());

const examBadges = (entry.data.usedInExams ?? [])
  .map((examId: string) => getExamConfig(examId)?.name)
  .filter(Boolean);

const breadcrumbs = isOverview
  ? [
      { label: 'Notes', href: '/notes/' },
      { label: entry.data.title, href: `/notes/${subject}` },
    ]
  : [
      { label: 'Notes', href: '/notes/' },
      { label: subjectLabel, href: `/notes/${subject}` },
      { label: entry.data.title, href: `/notes/${Astro.params.slug}` },
    ];

const { Content } = await entry.render();
---

<NotesLayout
  title={entry.data.title}
  description={entry.data.description}
  breadcrumbs={breadcrumbs}
  noIndex={isOverview && sections.length === 0}
>
  {sections.length > 0 && (
    <Fragment slot="sidebar">
      <NotesSidebar
        subjectLabel={subjectLabel}
        subject={subject}
        items={sections}
        currentSlug={currentSlug}
      />
    </Fragment>
  )}

  <div class="section-label">
    {isOverview ? 'Subject Overview' : 'Section'}
  </div>
  <h1>{entry.data.title}</h1>
  <p style="color: var(--color-text-muted); margin-bottom: 0.75rem;">{entry.data.description}</p>
  {examBadges.length > 0 && (
    <div class="exam-badges">
      {examBadges.map((name) => <span class="exam-badge">{name}</span>)}
    </div>
  )}
  <div style="margin-bottom: 1.25rem;"></div>

  <Content />

  {relatedCheatsheet && (
    <a href={relatedCheatsheet.href} class="cross-link-callout">
      ⚡ Need a fast revision version? See the <strong>{relatedCheatsheet.title}</strong> →
    </a>
  )}

  {isOverview && sections.length > 0 && (
    <>
      <h2 style="margin-top: 3rem;">Sections</h2>
      <div class="section-grid">
        {sections.map((section) => (
          <a href={`/notes/${subject}/${section.slug}`} class="section-card">
            <h3>{section.title}</h3>
            <p>{section.description}</p>
            <span class="card-time">{section.readTime}</span>
          </a>
        ))}
      </div>
    </>
  )}

  {!isOverview && (
    <>
      <div class="note-pager">
        {prevNote ? (
          <a href={`/notes/${subject}/${prevNote.slug}/`} class="pager-link prev">
            <span class="dir">← Previous</span>
            <span class="pager-title">{prevNote.title}</span>
          </a>
        ) : <span />}
        {nextNote ? (
          <a href={`/notes/${subject}/${nextNote.slug}/`} class="pager-link next">
            <span class="dir">Next →</span>
            <span class="pager-title">{nextNote.title}</span>
          </a>
        ) : <span />}
      </div>
      <a href={`/notes/${subject}`} class="back-link">← Back to {subjectLabel}</a>
    </>
  )}
</NotesLayout>

<style>
  .cross-link-callout {
    display: block;
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 10px;
    color: #1e3a8a;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .cross-link-callout:hover {
    border-color: #93c5fd;
    background: #dbeafe;
  }
  .cross-link-callout strong {
    color: #1e40af;
  }
  .note-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 45%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text);
  }
  .pager-link:hover {
    border-color: var(--color-primary);
  }
  .pager-link.next {
    text-align: right;
    margin-left: auto;
  }
  .pager-link .dir {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  .pager-link .pager-title {
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
