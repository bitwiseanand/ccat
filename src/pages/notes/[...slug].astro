---
import { getCollection } from 'astro:content';
import NotesLayout from '../../layouts/NotesLayout.astro';
import NotesSidebar from '../../components/NotesSidebar.astro';
import { getExamConfig } from '../../data/exams';
import { notesCourseOrder } from '../../data/notesCourseOrder';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => {
    const id = note.id.replace(/\.mdx?$/, '');
    const slug = id.endsWith('/overview') ? id.replace(/\/overview$/, '') : id;
    const subject = id.split('/')[0];
    return {
      params: { slug },
      props: { entry: note, subject, isOverview: id.endsWith('/overview') },
    };
  });
}

const { entry, subject, isOverview } = Astro.props;

const allNotes = await getCollection('notes');

function readTimeFor(body: string): string {
  const words = body.trim().split(/\s+/).filter(Boolean).length;
  return `${Math.max(1, Math.round(words / 200))} min read`;
}

function labelFor(subjectSlug: string): string {
  return subjectSlug.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
}

// Every real subject (has at least one non-overview note), in course order.
// Subjects not yet in notesCourseOrder fall back to the end, alphabetically,
// so a newly-added subject doesn't just silently vanish from the course.
const subjectsWithContent = Array.from(new Set(allNotes.map((n) => n.id.split('/')[0])))
  .filter((s) => allNotes.some((n) => {
    const nid = n.id.replace(/\.mdx?$/, '');
    return nid.startsWith(`${s}/`) && !nid.endsWith('/overview');
  }))
  .sort((a, b) => {
    const ai = notesCourseOrder.indexOf(a);
    const bi = notesCourseOrder.indexOf(b);
    if (ai === -1 && bi === -1) return a.localeCompare(b);
    if (ai === -1) return 1;
    if (bi === -1) return -1;
    return ai - bi;
  });

// Full course outline, grouped by subject, each subject's notes sorted by
// its own `order` field — this is what both the sidebar and cross-subject
// Prev/Next are derived from.
const courseGroups = subjectsWithContent.map((s) => ({
  subject: s,
  subjectLabel: labelFor(s),
  items: allNotes
    .filter((n) => {
      const nid = n.id.replace(/\.mdx?$/, '');
      return nid.startsWith(`${s}/`) && !nid.endsWith('/overview');
    })
    .map((n) => ({
      title: n.data.title,
      description: n.data.description,
      slug: n.id.replace(/\.mdx?$/, '').replace(`${s}/`, ''),
      order: n.data.order || 999,
      readTime: readTimeFor(n.body || ''),
    }))
    .sort((a, b) => a.order - b.order),
}));

// Flattened, in course order — last item of one subject is immediately
// followed by the first item of the next, which is what makes Prev/Next
// flow across subject boundaries instead of stopping at each one's edge.
const flatCourse = courseGroups.flatMap((g) =>
  g.items.map((item) => ({ ...item, subject: g.subject }))
);

// This subject's own notes (still needed for the overview page's grid).
const sections = courseGroups.find((g) => g.subject === subject)?.items ?? [];

const currentSlug = isOverview ? '' : entry.id.replace(/\.mdx?$/, '').replace(`${subject}/`, '');

let prevNote: { title: string; slug: string; subject: string } | null = null;
let nextNote: { title: string; slug: string; subject: string } | null = null;
if (!isOverview) {
  const idx = flatCourse.findIndex((s) => s.subject === subject && s.slug === currentSlug);
  if (idx > 0) prevNote = flatCourse[idx - 1];
  if (idx >= 0 && idx < flatCourse.length - 1) nextNote = flatCourse[idx + 1];
}

// Resolve the optional cross-link to a fast-revision cheat sheet, if this
// note declares one (relatedCheatsheet stored as "exam/slug").
let relatedCheatsheet: { title: string; href: string } | null = null;
if (entry.data.relatedCheatsheet) {
  const sheets = await getCollection('cheatsheets');
  const match = sheets.find((s) => s.id.replace(/\.md$/, '') === entry.data.relatedCheatsheet);
  if (match) {
    const [sheetExam, ...rest] = match.id.replace(/\.md$/, '').split('/');
    relatedCheatsheet = {
      title: match.data.title,
      href: `/${sheetExam}/cheat-sheets/${rest.join('/')}/`,
    };
  }
}

const subjectLabel = subject.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());

const examBadges = (entry.data.usedInExams ?? [])
  .map((examId: string) => getExamConfig(examId)?.name)
  .filter(Boolean);

const breadcrumbs = isOverview
  ? [
      { label: 'Notes', href: '/notes/' },
      { label: entry.data.title, href: `/notes/${subject}` },
    ]
  : [
      { label: 'Notes', href: '/notes/' },
      { label: subjectLabel, href: `/notes/${subject}` },
      { label: entry.data.title, href: `/notes/${Astro.params.slug}` },
    ];

const { Content } = await entry.render();
---

<NotesLayout
  title={entry.data.title}
  description={entry.data.description}
  breadcrumbs={breadcrumbs}
  noIndex={isOverview && sections.length === 0}
>
  {courseGroups.length > 0 && (
    <Fragment slot="sidebar">
      <NotesSidebar
        groups={courseGroups}
        currentSubject={subject}
        currentSlug={currentSlug}
      />
    </Fragment>
  )}

  <div class="section-label">
    {isOverview ? 'Subject Overview' : 'Section'}
  </div>
  <h1>{entry.data.title}</h1>
  <p style="color: var(--color-text-muted); margin-bottom: 0.75rem;">{entry.data.description}</p>
  {examBadges.length > 0 && (
    <div class="exam-badges">
      {examBadges.map((name) => <span class="exam-badge">{name}</span>)}
    </div>
  )}
  <div style="margin-bottom: 1.25rem;"></div>

  <Content />

  {relatedCheatsheet && (
    <a href={relatedCheatsheet.href} class="cross-link-callout">
      ⚡ Need a fast revision version? See the <strong>{relatedCheatsheet.title}</strong> →
    </a>
  )}

  {isOverview && sections.length > 0 && (
    <>
      <h2 style="margin-top: 3rem;">Sections</h2>
      <div class="section-grid">
        {sections.map((section) => (
          <a href={`/notes/${subject}/${section.slug}`} class="section-card">
            <h3>{section.title}</h3>
            <p>{section.description}</p>
            <span class="card-time">{section.readTime}</span>
          </a>
        ))}
      </div>
    </>
  )}

  {!isOverview && (
    <>
      <div class="note-pager">
        {prevNote ? (
          <a href={`/notes/${prevNote.subject}/${prevNote.slug}/`} class="pager-link prev">
            <span class="dir">
              ← Previous{prevNote.subject !== subject ? ` · ${labelFor(prevNote.subject)}` : ''}
            </span>
            <span class="pager-title">{prevNote.title}</span>
          </a>
        ) : <span />}
        {nextNote ? (
          <a href={`/notes/${nextNote.subject}/${nextNote.slug}/`} class="pager-link next">
            <span class="dir">
              Next{nextNote.subject !== subject ? ` · ${labelFor(nextNote.subject)}` : ''} →
            </span>
            <span class="pager-title">{nextNote.title}</span>
          </a>
        ) : <span />}
      </div>
      <a href={`/notes/${subject}`} class="back-link">← Back to {subjectLabel}</a>
    </>
  )}
</NotesLayout>

<style>
  .cross-link-callout {
    display: block;
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 10px;
    color: #1e3a8a;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .cross-link-callout:hover {
    border-color: #93c5fd;
    background: #dbeafe;
  }
  .cross-link-callout strong {
    color: #1e40af;
  }
  .note-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 45%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text);
  }
  .pager-link:hover {
    border-color: var(--color-primary);
  }
  .pager-link.next {
    text-align: right;
    margin-left: auto;
  }
  .pager-link .dir {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  .pager-link .pager-title {
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
